{
  "name": "@kegesch/arc",
  "version": "0.7.0",
  "description": "Architecture, Requirements & Choices — traceability for humans and agents",
  "type": "module",
  "keywords": [
    "architecture",
    "adr",
    "decision-records",
    "requirements",
    "traceability",
    "cli"
  ],
  "author": "kegesch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kegesch/arc.git"
  },
  "bin": {
    "arc": "./bin/arc.cjs"
  },
  "files": [
    "bin",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./skill"
    ]
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile arc",
    "build:platform": "node scripts/build-binary.cjs",
    "test": "bun test",
    "prepublishOnly": "echo 'Publishing via bun. The per-platform binaries are built and published by CI.'"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "commander": "^13.1.0",
    "typescript": "^5.8.0",
    "yaml": "^2.7.1"
  },
  "optionalDependencies": {
    "@kegesch/arc-linux-x64": "0.7.0",
    "@kegesch/arc-linux-arm64": "0.7.0",
    "@kegesch/arc-darwin-x64": "0.7.0",
    "@kegesch/arc-darwin-arm64": "0.7.0",
    "@kegesch/arc-win32-x64": "0.7.0"
  }
}
